FF=[FF1,FF2]

V0=np.zeros(N)
C_m=np.zeros(N)
vr=np.zeros(N)
gL=np.zeros(N)
vt=np.zeros(N)
tauvth=np.zeros(N)
alpha=np.zeros((N,3))

for i in PYR:
    V0[i]=-78e-3
    C_m[i]=300e-12
    vr[i]=-78e-3

M[FB2,PYR2]=MFB
M[FB2,FB1]=MFB

M[FF1,PYR1]=MFF
M[FF1,PYR2]=MFF
M[FF1,FF2]=MFF
M[FF2,PYR1]=MFF
M[FF2,PYR2]=MFF
M[FF2,FF1]=MFF

# ============================================================
# AP RELEASE PROBABILITIES
#
# prAP[pre,post] = fusion probability during an AP
#                  generated by the presynaptic neuron
# ============================================================

prAP=np.zeros((N,N))

for pre in PYR:
    for post in range(N):
        if W[pre,post]!=0:
            prAP[pre,post]=prAPPYR

for pre in FB:
    for post in range(N):
        if W[pre,post]!=0:
            prAP[pre,post]=prAPFB

for pre in FF:
    for post in range(N):
        if W[pre,post]!=0:
            prAP[pre,post]=prAPFF

# ============================================================
# SPONTANEOUS MINI EVENT RATES
#
# Each synaptic connection has its own independent
# Poisson process.
# ============================================================

mini_rate=np.zeros((N,N))

mini_rate[PYR1,PYR2]=RATE_PYR_PYR
mini_rate[PYR2,PYR1]=RATE_PYR_PYR

mini_rate[PYR1,FB1]=RATE_PYR_FB
mini_rate[PYR2,FB1]=RATE_PYR_FB

mini_rate[FB1,PYR1]=RATE_FB_PYR
mini_rate[FB1,PYR2]=RATE_FB_PYR

mini_rate[FF1,PYR1]=RATE_FF_PYR
mini_rate[FF1,PYR2]=RATE_FF_PYR

# ============================================================
# REPLENISHMENT RATE COEFFICIENT
#
# Still presynaptic-neuron-specific.
# Each connection-specific pool independently refills.
# ============================================================

kPYR2=kPYR1
kFB2=kFB1
kFF2=kFF1
k=[kPYR1,kPYR2,kFB1,kFB2,kFF1,kFF2]

time=np.arange(0,T,dt)

if ttype==0:
    W[PYR2,PYR1],W[PYR1,PYR2]=0,0

if ttype==1:
    W[FB1,PYR1],W[FB2,PYR1],W[FB1,PYR2],W[FB2,PYR2]=0,0,0,0

if ttype==2:
    W[FF1,PYR1],W[FF2,PYR1],W[FF1,PYR2],W[FF2,PYR2]=0,0,0,0

# ============================================================
# SYNAPTIC CURRENT PARAMETERS
# ============================================================

AP_amplitude=np.zeros((N,N))
mini_amplitude=np.zeros((N,N))
tau_rise=np.zeros((N,N))
tau_fall=np.zeros((N,N))

AP_amplitude[PYR1,PYR2]=AP_PYR_PYR
AP_amplitude[PYR2,PYR1]=AP_PYR_PYR
AP_amplitude[PYR1,FB1]=AP_PYR_FB
AP_amplitude[PYR2,FB1]=AP_PYR_FB
AP_amplitude[FB1,PYR1]=AP_FB_PYR
AP_amplitude[FB1,PYR2]=AP_FB_PYR
AP_amplitude[FF1,PYR1]=AP_FF_PYR
AP_amplitude[FF1,PYR2]=AP_FF_PYR

mini_amplitude[PYR1,PYR2]=MINI_PYR_PYR
mini_amplitude[PYR2,PYR1]=MINI_PYR_PYR
mini_amplitude[PYR1,FB1]=MINI_PYR_FB
mini_amplitude[PYR2,FB1]=MINI_PYR_FB
mini_amplitude[FB1,PYR1]=MINI_FB_PYR
mini_amplitude[FB1,PYR2]=MINI_FB_PYR
mini_amplitude[FF1,PYR1]=MINI_FF_PYR
mini_amplitude[FF1,PYR2]=MINI_FF_PYR

tau_rise[PYR1,PYR2]=RISE_PYR_PYR
tau_rise[PYR2,PYR1]=RISE_PYR_PYR
tau_rise[PYR1,FB1]=RISE_PYR_FB
tau_rise[PYR2,FB1]=RISE_PYR_FB
tau_rise[FB1,PYR1]=RISE_FB_PYR
tau_rise[FB1,PYR2]=RISE_FB_PYR
tau_rise[FF1,PYR1]=RISE_FF_PYR
tau_rise[FF1,PYR2]=RISE_FF_PYR

tau_fall[PYR1,PYR2]=FALL_PYR_PYR
tau_fall[PYR2,PYR1]=FALL_PYR_PYR
tau_fall[PYR1,FB1]=FALL_PYR_FB
tau_fall[PYR2,FB1]=FALL_PYR_FB
tau_fall[FB1,PYR1]=FALL_FB_PYR
tau_fall[FB1,PYR2]=FALL_FB_PYR
tau_fall[FF1,PYR1]=FALL_FF_PYR
tau_fall[FF1,PYR2]=FALL_FF_PYR

# ============================================================
# GAUSSIAN NOISE
#
# Only FF1 and FF2 receive Gaussian noise.
# PYR and FB neurons receive no Gaussian noise.
# ============================================================

def getnoise(noise,i):
    if i in PYR:
        return 0.0
    if i in FB:
        return 0.0
    return abs(np.random.normal(0,noise[2]))

# ============================================================
# RATE ACCUMULATION
# ============================================================

rate_acc=np.zeros((navgs,N))
std_acc=np.zeros((navgs,N))

V_last=None
I_last=None
spike_peak_last=None
Vth_last=None

# ============================================================
# SIMULATION
# ============================================================

for run in tqdm(range(navgs),desc="Running simulations",unit="run"):

    V=np.zeros((N,len(time)))
    vth=np.zeros((N,len(time)))
    spikes=np.zeros((N,len(time)))

    # Ispike[pre,post] is the current generated at the
    # connection from pre to post.
    Ispike=np.zeros((N,N))

    # Separate exponential components for every connection.
    I_decay=np.zeros((N,N))
    I_rise=np.zeros((N,N))

    # Each synaptic connection has its own independent pool.
    ndsv=M.copy()

    # Independent replenishment timer for every synapse.
    next_refill=np.full((N,N),np.inf)

    # Independent next mini-event time for every
    # presynaptic-to-postsynaptic connection.
    next_mini=np.full((N,N),np.inf)

    for pre in range(N):
        for post in range(N):
            if W[pre,post]==0:
                continue

            if mini_rate[pre,post]>0:
                wait=np.random.exponential(1/mini_rate[pre,post])
                next_mini[pre,post]=wait

    if run==navgs-1:
        spike_peak_last=np.full((N,len(time)),np.nan)

        # Store total incoming current for every neuron.
        I_last=np.zeros((N,len(time)))

        # Store connection-specific incoming currents.
        # Iconn_last[pre,post,t] is the current from pre into post.
        Iconn_last=np.zeros((N,N,len(time)))

        # Store OB current separately.
        I_OB_last=np.zeros((N,len(time)))

    V[:,0]=V0
    vth[:,0]=vt

    rfon=np.zeros(N)
    rftimer=np.ones(N)*np.inf

    # ========================================================
    # PRECOMPUTE OB CURRENTS
    # ========================================================

    I_OB_PYR1=make_ob_current(time,PYR1_OB_times,A_OB_PYR)
    I_OB_PYR2=make_ob_current(time,PYR2_OB_times,A_OB_PYR)
    I_OB_FF1=make_ob_current(time,FF1_OB_times,A_OB_FF)
    I_OB_FF2=make_ob_current(time,[],A_OB_FF2)

    # ========================================================
    # TIME LOOP
    # ========================================================

    for t in range(1,len(time)):

        current_time=t*dt

        # ====================================================
        # REPLENISH EACH SYNAPTIC POOL INDEPENDENTLY
        # ====================================================

        for pre in range(N):
            for post in range(N):
                if W[pre,post]==0:
                    continue

                if current_time>=next_refill[pre,post] and ndsv[pre,post]<M[pre,post]:
                    ndsv[pre,post]+=1

                    if ndsv[pre,post]<M[pre,post]:
                        rate=k[pre]*(M[pre,post]-ndsv[pre,post])
                        wait=np.random.exponential(1/rate)
                        next_refill[pre,post]=current_time+wait
                    else:
                        next_refill[pre,post]=np.inf

        # ====================================================
        # SPONTANEOUS MINI EVENTS
        #
        # Each synaptic connection has its own independent
        # Poisson process.
        #
        # Each mini event releases exactly one docked SV.
        # ====================================================

        for pre in range(N):
            for post in range(N):
                if W[pre,post]==0:
                    continue

                if current_time>=next_mini[pre,post]:

                    if ndsv[pre,post]>0:
                        ndsv[pre,post]-=1

                        if tau_rise[pre,post]>0 and tau_fall[pre,post]>0:
                            t_peak=(tau_rise[pre,post]*tau_fall[pre,post]/(tau_fall[pre,post]-tau_rise[pre,post]))*np.log(tau_fall[pre,post]/tau_rise[pre,post])
                            norm=np.exp(-t_peak/tau_fall[pre,post])-np.exp(-t_peak/tau_rise[pre,post])
                            I_decay[pre,post]+=mini_amplitude[pre,post]/norm
                            I_rise[pre,post]+=mini_amplitude[pre,post]/norm
                        else:
                            Ispike[pre,post]+=mini_amplitude[pre,post]

                        if ndsv[pre,post]<M[pre,post]:
                            rate=k[pre]*(M[pre,post]-ndsv[pre,post])
                            wait=np.random.exponential(1/rate)
                            next_refill[pre,post]=current_time+wait

                    if mini_rate[pre,post]>0:
                        wait=np.random.exponential(1/mini_rate[pre,post])
                        next_mini[pre,post]=current_time+wait
                    else:
                        next_mini[pre,post]=np.inf

        # ====================================================
        # DECAY EACH SYNAPTIC CURRENT INDEPENDENTLY
        # ====================================================

        for pre in range(N):
            for post in range(N):
                if W[pre,post]==0:
                    continue

                if tau_rise[pre,post]>0 and tau_fall[pre,post]>0:
                    I_decay[pre,post]+=dt*(-I_decay[pre,post]/tau_fall[pre,post])
                    I_rise[pre,post]+=dt*(-I_rise[pre,post]/tau_rise[pre,post])
                    Ispike[pre,post]=I_decay[pre,post]-I_rise[pre,post]

        # ====================================================
        # OB INPUT CURRENT
        #
        # PYR1 receives N_OB actual OB neurons.
        # PYR2 receives N_OB actual OB neurons.
        # FF1 receives 6*N_OB actual OB neurons.
        # FF2 has an OB pathway with zero amplitude.
        # ====================================================

        I_OB_PYR1_t=I_OB_PYR1[t]
        I_OB_PYR2_t=I_OB_PYR2[t]
        I_OB_FF1_t=I_OB_FF1[t]
        I_OB_FF2_t=I_OB_FF2[t]

        # ====================================================
        # STORE INCOMING CURRENTS
        #
        # Iconn_last[pre,post,t] = current from pre into post.
        # I_last[post,t] = total synaptic current entering post.
        # ====================================================

        if run==navgs-1:
            Iconn_last[:,:,t]=Ispike

            for post in range(N):
                I_last[post,t]=np.sum(Ispike[:,post])

            I_OB_last[PYR1,t]=I_OB_PYR1_t
            I_OB_last[PYR2,t]=I_OB_PYR2_t
            I_OB_last[FF1,t]=I_OB_FF1_t
            I_OB_last[FF2,t]=I_OB_FF2_t

        # ====================================================
        # UPDATE NEURONS
        # ====================================================

        for post in range(N):

            Inoise=getnoise(noise,post)
            Isyn=np.sum(Ispike[:,post])

            if post==PYR1:
                I_OB=I_OB_PYR1_t
            elif post==PYR2:
                I_OB=I_OB_PYR2_t
            elif post==FF1:
                I_OB=I_OB_FF1_t
            elif post==FF2:
                I_OB=I_OB_FF2_t
            else:
                I_OB=0.0

            I=Isyn+I_OB+Inoise

            i_ion=gL[post]*(V[post,t-1]-V0[post])
            dVdt=(I-i_ion)/C_m[post]

            V[post,t]=V[post,t-1]+dt*dVdt*(1-rfon[post])

            dvthdt=-(vth[post,t-1]-vt[post])/tauvth[post]
            vth[post,t]=vth[post,t-1]+dt*dvthdt

            if rftimer[post]!=np.inf:
                rftimer[post]-=dt

            if rftimer[post]<=0:
                rftimer[post]=np.inf
                rfon[post]=False

            # =================================================
            # POSTSYNAPTIC NEURON FIRES AN AP
            # =================================================

            if V[post,t]>vth[post,t]:

                spikes[post,t]=1

                if run==navgs-1:
                    spike_peak_last[post,t]=V[post,t]

                rfon[post]=True
                rftimer[post]=rf

                # =============================================
                # AP-EVOKED RELEASE
                #
                # The AP from 'post' acts as a presynaptic AP
                # onto every target of neuron 'post'.
                #
                # Each connection independently draws from
                # its own SV pool using prAP[post,target].
                # =============================================

                for target in range(N):

                    if W[post,target]==0:
                        continue

                    B=np.random.binomial(ndsv[post,target],prAP[post,target])

                    ndsv[post,target]-=B

                    if B>0:

                        if tau_rise[post,target]>0 and tau_fall[post,target]>0:
                            t_peak=(tau_rise[post,target]*tau_fall[post,target]/(tau_fall[post,target]-tau_rise[post,target]))*np.log(tau_fall[post,target]/tau_rise[post,target])
                            norm=np.exp(-t_peak/tau_fall[post,target])-np.exp(-t_peak/tau_rise[post,target])
                            I_decay[post,target]+=AP_amplitude[post,target]*B/norm
                            I_rise[post,target]+=AP_amplitude[post,target]*B/norm
                        else:
                            Ispike[post,target]+=AP_amplitude[post,target]*B

                    if B>0 and ndsv[post,target]<M[post,target]:
                        rate=k[post]*(M[post,target]-ndsv[post,target])
                        wait=np.random.exponential(1/rate)
                        next_refill[post,target]=current_time+wait

                # =============================================
                # ADAPTIVE THRESHOLD
                # =============================================

                vth[post,t]+=alpha[post,0]+alpha[post,1]*(V[post,t]/vt[post])+alpha[post,2]*(V[post,t]/vt[post])**2

                V[post,t]=vr[post]

    # ========================================================
    # SAVE FINAL RUN
    # ========================================================

    if run==navgs-1:
        V_last=V.copy()
        Vth_last=vth.copy()

    # ========================================================
    # FIRING RATES AND STD FOR THIS RUN
    # ========================================================

    for i in range(N):

        spike_times=time[spikes[i]==1]

        if len(spike_times)>1:

            isi=np.diff(spike_times)

            # Rate for this run
            rate_acc[run,i]=1/np.mean(isi)

            # STD for this run in Hz
            rate_per_isi=1/isi
            std_acc[run,i]=np.std(rate_per_isi)

        else:
            rate_acc[run,i]=np.nan
            std_acc[run,i]=np.nan

# ============================================================
# MEAN FIRING RATES AND STD
# ============================================================

mean_rate=np.nanmean(rate_acc,axis=0)
std_rate=np.nanstd(rate_acc,axis=0)
mean_std=np.nanmean(std_acc,axis=0)

print("Mean firing rates (Hz):")
print(mean_rate)

print("STD of mean firing rates across runs (Hz):")
print(std_rate)

print("Mean STD within runs (Hz):")
print(mean_std)

# ============================================================
# PLOTS
# ============================================================

fs=15

plot_neurons=[PYR1,PYR2,FB1,FF1]

if ptype==0:

    fig,ax=plt.subplots(4,2,figsize=(16,10),sharex=True)

    for j,i in enumerate(plot_neurons):

        rate_text=(f"rate = {mean_rate[i]:.2f} Hz, STD_rates ={std_rate[i]:.2f} Hz"
                   if not np.isnan(mean_rate[i]) else "rate = N/A")

        # ====================================================
        # MEMBRANE POTENTIAL
        # ====================================================

        ax[j,0].plot(time,V_last[i]*1000,label="V")

        mask=~np.isnan(spike_peak_last[i])

        ax[j,0].scatter(time[mask],spike_peak_last[i,mask]*1000,s=60,color="black",zorder=5,label="Spike")
        ax[j,0].set_ylabel(names[i]+" (mV)",fontsize=fs)

        if i in [PYR1,PYR2]:
            ax[j,0].set_title(rate_text+f", N_OB = {N_OB}",fontsize=fs)
        elif i==FF1:
            ax[j,0].set_title(rate_text+f", N_OB = {6*N_OB}",fontsize=fs)
        else:
            ax[j,0].set_title(rate_text,fontsize=fs)

        ax[j,0].legend(fontsize=fs-2,loc="upper right")
        ax[j,0].tick_params(axis="both",labelsize=fs)

        # ====================================================
        # INCOMING SYNAPTIC CURRENTS
        # ====================================================

        connected_inputs=np.where(W[:,i]!=0)[0]

        for pre in connected_inputs:
            ax[j,1].plot(time,Iconn_last[pre,i]*1e12,label=f"{names[pre]}")

        if i in [PYR1,PYR2,FF1]:
            ax[j,1].plot(time,I_OB_last[i]*1e12,label="OB")

        ax[j,1].set_ylabel("I(t) (pA)",fontsize=fs)

        if i in [PYR1,PYR2]:
            ax[j,1].set_title(names[i]+" Incoming Current"+f", N_OB = {N_OB}",fontsize=fs)
        elif i==FF1:
            ax[j,1].set_title(names[i]+" Incoming Current"+f", N_OB = {6*N_OB}",fontsize=fs)
        else:
            ax[j,1].set_title(names[i]+" Incoming Current",fontsize=fs)

        ax[j,1].legend(fontsize=fs-2,loc="upper right")
        ax[j,1].tick_params(axis="both",labelsize=fs)

    ax[-1,0].set_xlabel("Time (sec)",fontsize=fs)
    ax[-1,1].set_xlabel("Time (sec)",fontsize=fs)

    plt.tight_layout()
    plt.show()

elif ptype==1:

    n_inputs=[]

    for i in plot_neurons:
        n_inputs.append(len(np.where(W[:,i]!=0)[0])+(1 if i in [PYR1,PYR2,FF1] else 0))

    nrows=max(1+np.max(n_inputs),2)

    fig,ax=plt.subplots(nrows,4,figsize=(20,4*nrows),sharex=True,squeeze=False)

    for j,i in enumerate(plot_neurons):

        rate_text=(f"rate = {mean_rate[i]:.2f} Hz, STD_rates ={std_rate[i]:.2f} Hz"
                   if not np.isnan(mean_rate[i]) else "rate = N/A")

        # ====================================================
        # MEMBRANE POTENTIAL
        # ====================================================

        vax=ax[0,j]

        vax.plot(time,V_last[i]*1000,label="V")

        mask=~np.isnan(spike_peak_last[i])

        vax.scatter(time[mask],spike_peak_last[i,mask]*1000,s=60,color="black",zorder=5,label="Spike")
        vax.set_ylabel(names[i]+" (mV)",fontsize=fs)

        if i in [PYR1,PYR2]:
            vax.set_title(rate_text+f", N_OB = {N_OB}",fontsize=fs)
        elif i==FF1:
            vax.set_title(rate_text+f", N_OB = {6*N_OB}",fontsize=fs)
        else:
            vax.set_title(rate_text,fontsize=fs)

        vax.legend(fontsize=fs-2,loc="upper right")
        vax.tick_params(axis="both",labelsize=fs)

        # ====================================================
        # INCOMING SYNAPTIC CURRENTS
        # ====================================================

        row=1

        connected_inputs=np.where(W[:,i]!=0)[0]

        for pre in connected_inputs:

            iax=ax[row,j]

            iax.plot(time,Iconn_last[pre,i]*1e12,label=f"{names[pre]}")
            iax.set_ylabel("I (pA)",fontsize=fs)
            iax.set_title(names[pre]+" to "+names[i],fontsize=fs)

            iax.legend(fontsize=fs-2,loc="upper right")
            iax.tick_params(axis="both",labelsize=fs)

            row+=1

        if i in [PYR1,PYR2,FF1]:

            iax=ax[row,j]

            iax.plot(time,I_OB_last[i]*1e12,label="OB")
            iax.set_ylabel("I (pA)",fontsize=fs)
            iax.set_title("OB to "+names[i],fontsize=fs)

            iax.legend(fontsize=fs-2,loc="upper right")
            iax.tick_params(axis="both",labelsize=fs)

            row+=1

        # ====================================================
        # HIDE UNUSED SUBPLOTS
        # ====================================================

        for r in range(row,nrows):
            ax[r,j].axis("off")

        ax[row-1,j].set_xlabel("Time (sec)",fontsize=fs)

    plt.tight_layout()
    plt.show()



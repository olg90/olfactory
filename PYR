prAPPYR=0.1

prminiFB=0.01
prAPFB=0.20

prminiFF=0.05
prAPFF=0.20

prmini=np.zeros((N,N))
prAP=np.zeros((N,N))

for pre in PYR:
    for post in range(N):
        if W[pre,post]!=0:
            prmini[pre,post]=prminiPYR
            prAP[pre,post]=prAPPYR

for pre in FB:
    for post in range(N):
        if W[pre,post]!=0:
            prmini[pre,post]=prminiFB
            prAP[pre,post]=prAPFB

for pre in FF:
    for post in range(N):

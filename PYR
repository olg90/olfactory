                    alpha[post,0]
                    +alpha[post,1]*(
                        V[post,t]/vt[post]
                    )
                    +alpha[post,2]*(
                        V[post,t]/vt[post]
                    )**2
                )

                V[post,t]=vr[post]

    # ========================================================
    # STORE SELECTED CONNECTION CURRENT
    # ========================================================

    I_selected[t]=Ispike[
        SPIKE_FROM,
        SPIKE_TO
    ]

    # ========================================================
    # STORE TARGET MEMBRANE-POTENTIAL CHANGE
    # ========================================================

    deltaV[t]=(
        V[SPIKE_TO,t]
        -V[SPIKE_TO,0]
    )


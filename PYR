vth_all=np.zeros((navgs,N,len(time)))
spikes_all=np.zeros((navgs,N,len(time)))
spike_peak=np.full((navgs,N,len(time)),np.nan)

# ============================================================
# SIMULATION
# ============================================================

taui_exc=20e-3
taui_inh=10e-3

for run in tqdm(range(navgs),desc="Running simulations",unit="run"):

    V=np.zeros((N,len(time)))
    vth=np.zeros((N,len(time)))
    spikes=np.zeros((N,len(time)))

    # Connection-specific synaptic currents
    Ispike=np.zeros((N,N))

    # Connection-specific SV pools
    ndsv=M.copy()

    # Independent refill timer for every connection
    next_refill=np.full((N,N),np.inf)

    # Independent mini-event process for every presynaptic neuron
    next_mini=np.zeros(N)

    for pre in range(N):

        if mini_rate[pre]>0:

        # ====================================================

        dvthdt=(
            -(vth[post,t-1]-vt[post])
            /tauvth[post]
        )

        vth[post,t]=(
            vth[post,t-1]
            +dt*dvthdt
        )

        # ====================================================
        # ONLY THE SELECTED PRESYNAPTIC NEURON IS ALLOWED
        # TO FIRE
        # ====================================================

        if post==SPIKE_FROM:

            if spikes[post,t]==1:


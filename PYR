# T=40#40
# navgs=1#10
# dt=1e-4
# rf=1e-3
# ttype=9 #0-pyrpyr,1-fbpyr,2-ffpyr
# =============================================================================

W=np.zeros((N,N))

W[PYR1,PYR2]=spyrpyr
W[PYR1,FB1]=spyrfb
W[PYR1,FB2]=spyrfb
W[PYR2,PYR1]=spyrpyr
W[PYR2,FB1]=spyrfb
W[PYR2,FB2]=spyrfb

W[FB1,PYR1]=sfbpyr
W[FB1,PYR2]=sfbfb
W[FB1,FB2]=sfbfb
W[FB2,PYR1]=sfbpyr
W[FB2,PYR2]=sfbpyr
W[FB2,FB1]=sfbfb

W[FF1,PYR1]=sffpyr
W[FF1,PYR2]=sffpyr
W[FF1,FF2]=sffff
W[FF2,PYR1]=sffpyr
W[FF2,PYR2]=sffpyr
W[FF2,FF1]=sffff

# ============================================================
# CONNECTION-SPECIFIC DOCKED SV POOLS
#
# M[pre,post] is the number of docked SVs belonging ONLY to
# the synapse from pre to post.
# ============================================================

M=np.zeros((N,N),dtype=int)

M[PYR1,PYR2]=MPYR
M[PYR1,FB1]=MPYR
M[PYR1,FB2]=MPYR
M[PYR2,PYR1]=MPYR
M[PYR2,FB1]=MPYR
M[PYR2,FB2]=MPYR

M[FB1,PYR1]=MFB
M[FB1,PYR2]=MFB
M[FB1,FB2]=MFB
M[FB2,PYR1]=MFB
M[FB2,PYR2]=MFB
M[FB2,FB1]=MFB

M[FF1,PYR1]=MFF
M[FF1,PYR2]=MFF
M[FF1,FF2]=MFF
M[FF2,PYR1]=MFF
M[FF2,PYR2]=MFF
M[FF2,FF1]=MFF

# ============================================================
# TWO RELEASE PROBABILITIES
#
# prmini[pre,post] = fusion probability during a spontaneous
#                     mini event
#
# prAP[pre,post] = fusion probability during an AP
#                  generated by the presynaptic neuron
# ============================================================

prmini=np.zeros((N,N))
prAP=np.zeros((N,N))

for pre in PYR:
    for post in range(N):
        if W[pre,post]!=0:
            prmini[pre,post]=prminiPYR
            prAP[pre,post]=prAPPYR

for pre in FB:
    for post in range(N):
        if W[pre,post]!=0:
            prmini[pre,post]=prminiFB
            prAP[pre,post]=prAPFB

for pre in FF:
    for post in range(N):
        if W[pre,post]!=0:
            prmini[pre,post]=prminiFF
            prAP[pre,post]=prAPFF
            
# ============================================================
# SPONTANEOUS MINI EVENT RATES
#
# Each presynaptic neuron has its own Poisson process.
# The rates are unique by neuron type here.
# ============================================================

mini_rate=np.zeros(N)

for i in PYR:
    mini_rate[i]=rminiPYR

for i in FB:
    mini_rate[i]=rminiFB

for i in FF:
    mini_rate[i]=rminiFF

# ============================================================
# REPLENISHMENT RATE COEFFICIENT
#
# Still presynaptic-neuron-specific.
# Each connection-specific pool independently refills.
# ============================================================

kPYR2=kPYR1
kFB2=kFB1
kFF2=kFF1
k=[kPYR1,kPYR2,kFB1,kFB2,kFF1,kFF2]

time=np.arange(0,T,dt)

if ttype==0:
    W[PYR2,PYR1],W[PYR1,PYR2]=0,0

if ttype==1:
    W[FB1,PYR1],W[FB2,PYR1],W[FB1,PYR2],W[FB2,PYR2]=0,0,0,0

if ttype==2:
    W[FF1,PYR1],W[FF2,PYR1],W[FF1,PYR2],W[FF2,PYR2]=0,0,0,0

# ============================================================
# GAUSSIAN NOISE
#
# Only FF1 and FF2 receive Gaussian noise.
# PYR and FB neurons receive no Gaussian noise.
# ============================================================

def getnoise(noise,i):
    if i in PYR:
        return 0.0
    if i in FB:
        return 0.0
    return abs(np.random.normal(0,noise[2]))

# ============================================================
# RATE ACCUMULATION
# ============================================================

rate_acc=np.zeros((navgs,N))
std_acc=np.zeros((navgs,N))

V_last=None
I_last=None
spike_peak_last=None
Vth_last=None

# ============================================================
# SIMULATION
# ============================================================
taui_exc=20e-3#fixed
taui_inh=10e-3#fixed

for run in tqdm(range(navgs),desc="Running simulations",unit="run"):

    V=np.zeros((N,len(time)))
    vth=np.zeros((N,len(time)))
    spikes=np.zeros((N,len(time)))

    # Ispike[pre,post] is the current generated at the
    # connection from pre to post.
    Ispike=np.zeros((N,N))

    # Each synaptic connection has its own independent pool.
    ndsv=M.copy()

    # Independent replenishment timer for every synapse.
    next_refill=np.full((N,N),np.inf)

    # Independent next mini-event time for every presynaptic neuron.
    next_mini=np.zeros(N)

    for pre in range(N):
        if mini_rate[pre]>0:
            wait=np.random.exponential(1/mini_rate[pre])
            next_mini[pre]=wait
        else:
            next_mini[pre]=np.inf

    if run==navgs-1:
        spike_peak_last=np.full((N,len(time)),np.nan)

        # Store total incoming current for every neuron.
        I_last=np.zeros((N,len(time)))

        # Store connection-specific incoming currents.
        # Iconn_last[pre,post,t] is the current from pre into post.
        Iconn_last=np.zeros((N,N,len(time)))

    V[:,0]=V0
    vth[:,0]=vt

    rfon=np.zeros(N)
    rftimer=np.ones(N)*np.inf

    # ========================================================
    # TIME LOOP
    # ========================================================

    for t in range(1,len(time)):

        current_time=t*dt

        # ====================================================
        # REPLENISH EACH SYNAPTIC POOL INDEPENDENTLY
        # ====================================================

        for pre in range(N):
            for post in range(N):
                if W[pre,post]==0:
                    continue

                if current_time>=next_refill[pre,post] and ndsv[pre,post]<M[pre,post]:
                    ndsv[pre,post]+=1

                    if ndsv[pre,post]<M[pre,post]:
                        rate=k[pre]*(M[pre,post]-ndsv[pre,post])
                        wait=np.random.exponential(1/rate)
                        next_refill[pre,post]=current_time+wait
                    else:
                        next_refill[pre,post]=np.inf

        # ====================================================
        # SPONTANEOUS MINI EVENTS
        #
        # Each presynaptic neuron has its own independent
        # exponential event process.
        #
        # A mini event from pre attempts fusion independently
        # at every postsynaptic connection.
        # ====================================================

        for pre in range(N):
            if current_time>=next_mini[pre]:
                for post in range(N):
                    if W[pre,post]==0:
                        continue

                    B=np.random.binomial(ndsv[pre,post],prmini[pre,post])
                    ndsv[pre,post]-=B
                    Ispike[pre,post]+=W[pre,post]*B

                    if B>0 and ndsv[pre,post]<M[pre,post]:
                        rate=k[pre]*(M[pre,post]-ndsv[pre,post])
                        wait=np.random.exponential(1/rate)
                        next_refill[pre,post]=current_time+wait

                # Schedule this presynaptic neuron's
                # next spontaneous mini event.
                if mini_rate[pre]>0:
                    wait=np.random.exponential(1/mini_rate[pre])
                    next_mini[pre]=current_time+wait
                else:
                    next_mini[pre]=np.inf

        # ====================================================
        # DECAY EACH SYNAPTIC CURRENT INDEPENDENTLY
        # ====================================================

        for pre in range(N):
            taui=taui_exc if pre in PYR else taui_inh
            for post in range(N):
                Ispike[pre,post]+=dt*(-Ispike[pre,post]/taui)

        # ====================================================
        # STORE INCOMING CURRENTS
        #
        # Iconn_last[pre,post,t] = current from pre into post.
        # I_last[post,t] = total synaptic current entering post.
        # ====================================================

        if run==navgs-1:
            Iconn_last[:,:,t]=Ispike

            for post in range(N):
                I_last[post,t]=np.sum(Ispike[:,post])

        # ====================================================
        # UPDATE NEURONS
        # ====================================================

        for post in range(N):

            Inoise=getnoise(noise,post)
            Isyn=np.sum(Ispike[:,post])
            I=Isyn+Inoise
            i_ion=gL[post]*(V[post,t-1]-V0[post])
            dVdt=(I-i_ion)/C_m[post]
            V[post,t]=V[post,t-1]+dt*dVdt*(1-rfon[post])
            dvthdt=-(vth[post,t-1]-vt[post])/tauvth[post]
            vth[post,t]=vth[post,t-1]+dt*dvthdt

            if rftimer[post]!=np.inf:
                rftimer[post]-=dt

            if rftimer[post]<=0:
                rftimer[post]=np.inf
                rfon[post]=False

            # =================================================
            # POSTSYNAPTIC NEURON FIRES AN AP
            # =================================================

            if V[post,t]>vth[post,t]:
                spikes[post,t]=1

                if run==navgs-1:
                    spike_peak_last[post,t]=V[post,t]

                rfon[post]=True
                rftimer[post]=rf

                # =============================================
                # AP-EVOKED RELEASE
                #
                # The AP from 'post' acts as a presynaptic AP
                # onto every target of neuron 'post'.
                #
                # Each connection independently draws from
                # its own SV pool using prAP[post,target].
                # =============================================

                for target in range(N):
                    if W[post,target]==0:
                        continue

                    B=np.random.binomial(ndsv[post,target],prAP[post,target])
                    ndsv[post,target]-=B
                    Ispike[post,target]+=W[post,target]*B

                    if B>0 and ndsv[post,target]<M[post,target]:
                        rate=k[post]*(M[post,target]-ndsv[post,target])
                        wait=np.random.exponential(1/rate)
                        next_refill[post,target]=current_time+wait

                # =============================================
                # ADAPTIVE THRESHOLD
                # =============================================

                vth[post,t]+=alpha[post,0]+alpha[post,1]*(V[post,t]/vt[post])+alpha[post,2]*(V[post,t]/vt[post])**2
                V[post,t]=vr[post]

    # ========================================================
    # SAVE FINAL RUN
    # ========================================================

    if run==navgs-1:
        V_last=V.copy()
        Vth_last=vth.copy()

    # ========================================================
    # FIRING RATES AND STD FOR THIS RUN
    # ========================================================

    for i in range(N):

        spike_times=time[spikes[i]==1]

        if len(spike_times)>1:

            isi=np.diff(spike_times)

            # Rate for this run
            rate_acc[run,i]=1/np.mean(isi)

            # STD for this run in Hz
            rate_per_isi=1/isi
            std_acc[run,i]=np.std(rate_per_isi)

        else:
            rate_acc[run,i]=np.nan
            std_acc[run,i]=np.nan

# ============================================================
# MEAN FIRING RATES AND STD
# ============================================================

mean_rate=np.nanmean(rate_acc,axis=0)
std_rate=np.nanstd(rate_acc,axis=0)
mean_std=np.nanmean(std_acc,axis=0)

print("Mean firing rates (Hz):")
print(mean_rate)

print("STD of mean firing rates across runs (Hz):")
print(std_rate)

print("Mean STD within runs (Hz):")
print(mean_std)

# ============================================================
# PLOTS
# ============================================================

fs=15

fig,ax=plt.subplots(6,2,figsize=(16,12),sharex=True)

for i in range(6):

    rate_text=(f"rate = {mean_rate[i]:.2f} Hz, STD_rates ={std_rate[i]:.2f} Hz"
               if not np.isnan(mean_rate[i]) else "rate = N/A")

    # ========================================================
    # MEMBRANE POTENTIAL
    # ========================================================

    ax[i,0].plot(time,V_last[i]*1000,label="V")

    mask=~np.isnan(spike_peak_last[i])

    ax[i,0].scatter(time[mask],spike_peak_last[i,mask]*1000,s=60,color="black",zorder=5,label="Spike")
    ax[i,0].set_ylabel(names[i]+" (mV)",fontsize=fs)
    ax[i,0].set_title(rate_text,fontsize=fs)
    ax[i,0].legend(fontsize=fs-2,loc="upper right")
    ax[i,0].tick_params(axis="both",labelsize=fs)

    # ========================================================
    # INCOMING SYNAPTIC CURRENTS
    # ========================================================

    connected_inputs=np.where(W[:,i]!=0)[0]

    for pre in connected_inputs:
        ax[i,1].plot(time,Iconn_last[pre,i]*1e12,label=f"{names[pre]}")

    ax[i,1].set_ylabel("I(t) (pA)",fontsize=fs)
    ax[i,1].set_title(names[i]+" Incoming Current",fontsize=fs)
    ax[i,1].legend(fontsize=fs-2,loc="upper right")
    ax[i,1].tick_params(axis="both",labelsize=fs)

ax[-1,0].set_xlabel("Time (sec)",fontsize=fs)
ax[-1,1].set_xlabel("Time (sec)",fontsize=fs)

plt.tight_layout()
plt.show()

#%% 7 - Single connection calibration
# One selected AP -> one selected postsynaptic neuron
# Connection-specific SV pool with single-vesicle minis
# Original synaptic-current dynamics preserved

import numpy as np
import matplotlib.pyplot as plt

N=6
PYR1,PYR2,FB1,FB2,FF1,FF2=range(6)
names=["PYR1","PYR2","FB1","FB2","FF1","FF2"]

PYR=[PYR1,PYR2]
FB=[FB1,FB2]
FF=[FF1,FF2]

# ============================================================
# SELECT CONNECTION TO CALIBRATE
# ============================================================

SPIKE_TIME=0.010

SPIKE_FROM=FF1
SPIKE_TO=PYR1

# ============================================================
# NEURON PARAMETERS
# ============================================================

V0=np.zeros(N)
C_m=np.zeros(N)
vr=np.zeros(N)
gL=np.zeros(N)
vt=np.zeros(N)
tauvth=np.zeros(N)
alpha=np.zeros((N,3))

for i in PYR:
    V0[i]=-78e-3
    C_m[i]=300e-12
    vr[i]=-78e-3
    gL[i]=1/(50e6)
    vt[i]=-77e-3
    tauvth[i]=7e-3
    alpha[i]=[75e-3,0,0]

for i in FB:
    V0[i]=-78e-3
    C_m[i]=250e-12
    vr[i]=-78e-3
    gL[i]=1/(50e6)
    vt[i]=-62e-3
    tauvth[i]=1e-3
    alpha[i]=[1e-3,1e-3,1e-3]

for i in FF:
    V0[i]=-78e-3
    C_m[i]=650e-12
    vr[i]=-78e-3
    gL[i]=1/(120e6)
    vt[i]=-70e-3
    tauvth[i]=1e-3
    alpha[i]=[1e-3,1e-3,1e-3]

# ============================================================
# CONNECTION MATRIX
# ============================================================

spyrpyr=5e-12
spyrfb=17.5e-12

sfbpyr=-201.7e-12
sfbfb=sfbpyr

sffff=-264e-12
sffpyr=-201.7e-12

W=np.zeros((N,N))

W[PYR1,PYR2]=spyrpyr
W[PYR1,FB1]=spyrfb
W[PYR1,FB2]=spyrfb
W[PYR2,PYR1]=spyrpyr
W[PYR2,FB1]=spyrfb
W[PYR2,FB2]=spyrfb

W[FB1,PYR1]=sfbpyr
W[FB1,PYR2]=sfbfb
W[FB1,FB2]=sfbfb
W[FB2,PYR1]=sfbpyr
W[FB2,PYR2]=sfbpyr
W[FB2,FB1]=sfbfb

W[FF1,PYR1]=sffpyr
W[FF1,PYR2]=sffpyr
W[FF1,FF2]=sffff
W[FF2,PYR1]=sffpyr
W[FF2,PYR2]=sffpyr
W[FF2,FF1]=sffff

# ============================================================
# CHECK CONNECTION
# ============================================================

if W[SPIKE_FROM,SPIKE_TO]==0:

    raise ValueError(
        f"No connection exists from "
        f"{names[SPIKE_FROM]} to {names[SPIKE_TO]}"
    )

# ============================================================
# SV POOL PARAMETERS
# ============================================================

M=np.zeros((N,N),dtype=int)

M[PYR1,PYR2]=5
M[PYR1,FB1]=5
M[PYR1,FB2]=5
M[PYR2,PYR1]=5
M[PYR2,FB1]=5
M[PYR2,FB2]=5

M[FB1,PYR1]=5
M[FB1,PYR2]=5
M[FB1,FB2]=5
M[FB2,PYR1]=5
M[FB2,PYR2]=5
M[FB2,FB1]=5

M[FF1,PYR1]=5
M[FF1,PYR2]=5
M[FF1,FF2]=5
M[FF2,PYR1]=5
M[FF2,PYR2]=5
M[FF2,FF1]=5

# ============================================================
# AP RELEASE PARAMETERS
# ============================================================

prAP=np.zeros((N,N))

prAP[PYR1,PYR2]=0.2
prAP[PYR1,FB1]=0.2
prAP[PYR1,FB2]=0.2
prAP[PYR2,PYR1]=0.2
prAP[PYR2,FB1]=0.2
prAP[PYR2,FB2]=0.2

prAP[FB1,PYR1]=0.2
prAP[FB1,PYR2]=0.2
prAP[FB1,FB2]=0.2
prAP[FB2,PYR1]=0.2
prAP[FB2,PYR2]=0.2
prAP[FB2,FB1]=0.2

prAP[FF1,PYR1]=0.2
prAP[FF1,PYR2]=0.2
prAP[FF1,FF2]=0.2
prAP[FF2,PYR1]=0.2
prAP[FF2,PYR2]=0.2
prAP[FF2,FF1]=0.2

# ============================================================
# MINI PARAMETERS
#
# Each synaptic connection has its own independent
# spontaneous mini process.
#
# Each mini releases exactly one docked SV.
# ============================================================

rminiPYR=30
rminiFB=30
rminiFF=30

mini_rate=np.zeros((N,N))

for pre in range(N):
    for post in range(N):

        if W[pre,post]==0:
            continue

        if pre in PYR:
            mini_rate[pre,post]=rminiPYR

        elif pre in FB:
            mini_rate[pre,post]=rminiFB

        elif pre in FF:
            mini_rate[pre,post]=rminiFF

# ============================================================
# REFILLING
# ============================================================

kPYR=1
kFB=1
kFF=1

k=np.zeros(N)

for i in PYR:
    k[i]=kPYR

for i in FB:
    k[i]=kFB

for i in FF:
    k[i]=kFF

# ============================================================
# SIMULATION PARAMETERS
# ============================================================

T=0.07
dt=1e-4
rf=1e-3

time=np.arange(0,T,dt)

# ============================================================
# SYNAPTIC CURRENT TIME CONSTANTS
# ============================================================

taui_exc=20e-3
taui_inh=10e-3

# ============================================================
# STORAGE
# ============================================================

V=np.zeros((N,len(time)))
vth=np.zeros((N,len(time)))
spikes=np.zeros((N,len(time)))

Ispike=np.zeros((N,N))

I_selected=np.zeros(len(time))

deltaV=np.zeros(len(time))

# ============================================================
# INITIAL CONDITIONS
# ============================================================

V[:,0]=V0
vth[:,0]=vt

# ============================================================
# CONNECTION-SPECIFIC SV POOLS
# ============================================================

ndsv=M.copy()

# ============================================================
# MINI EVENT TIMERS
#
# Each connection has its own independent Poisson clock.
# ============================================================

next_mini=np.full((N,N),np.inf)

for pre in range(N):
    for post in range(N):

        if W[pre,post]==0:
            continue

        if mini_rate[pre,post]>0:

            wait=np.random.exponential(
                1/mini_rate[pre,post]
            )

            next_mini[pre,post]=wait

# ============================================================
# REFILL TIMERS
# ============================================================

next_refill=np.full((N,N),np.inf)

# ============================================================
# TIME LOOP
# ============================================================

for t in range(1,len(time)):

    current_time=t*dt

    # ========================================================
    # REPLENISH EACH SYNAPTIC POOL INDEPENDENTLY
    # ========================================================

    for pre in range(N):

        for post in range(N):

            if W[pre,post]==0:
                continue

            if current_time>=next_refill[pre,post] and ndsv[pre,post]<M[pre,post]:

                ndsv[pre,post]+=1

                if ndsv[pre,post]<M[pre,post]:

                    rate=k[pre]*(
                        M[pre,post]-ndsv[pre,post]
                    )

                    wait=np.random.exponential(1/rate)

                    next_refill[pre,post]=(
                        current_time+wait
                    )

                else:

                    next_refill[pre,post]=np.inf

    # ========================================================
    # SPONTANEOUS MINI EVENTS
    #
    # Each connection has an independent Poisson process.
    #
    # One mini event releases exactly one docked SV.
    # ========================================================

    for pre in range(N):

        for post in range(N):

            if W[pre,post]==0:
                continue

            if current_time>=next_mini[pre,post]:

                if ndsv[pre,post]>0:

                    ndsv[pre,post]-=1

                    Ispike[pre,post]+=W[pre,post]

                    if ndsv[pre,post]<M[pre,post]:

                        rate=k[pre]*(
                            M[pre,post]-ndsv[pre,post]
                        )

                        wait=np.random.exponential(
                            1/rate
                        )

                        next_refill[pre,post]=(
                            current_time+wait
                        )

                # Schedule next mini event regardless
                # of whether an SV was available.

                if mini_rate[pre,post]>0:

                    wait=np.random.exponential(
                        1/mini_rate[pre,post]
                    )

                    next_mini[pre,post]=(
                        current_time+wait
                    )

                else:

                    next_mini[pre,post]=np.inf

    # ========================================================
    # DECAY EACH SYNAPTIC CURRENT
    #
    # THIS IS IDENTICAL TO THE ORIGINAL MODEL
    # ========================================================

    for pre in range(N):

        taui=taui_exc if pre in PYR else taui_inh

        for post in range(N):

            Ispike[pre,post]+=dt*(
                -Ispike[pre,post]/taui
            )

    # ========================================================
    # FORCE ONE PRESYNAPTIC AP
    # ========================================================

    if abs(current_time-SPIKE_TIME)<dt/2:

        spikes[SPIKE_FROM,t]=1

        # ====================================================
        # AP-EVOKED RELEASE
        #
        # The calibration uses the expected number of
        # released vesicles:
        #
        # E[B] = M*prAP
        #
        # For M=5 and prAP=0.2:
        #
        # E[B] = 1
        #
        # This preserves the original calibration.
        # ====================================================

        B=M[SPIKE_FROM,SPIKE_TO]*prAP[
            SPIKE_FROM,
            SPIKE_TO
        ]

        Ispike[SPIKE_FROM,SPIKE_TO]+=(
            W[SPIKE_FROM,SPIKE_TO]*B
        )

    # ========================================================
    # UPDATE NEURONS
    # ========================================================

    for post in range(N):

        Isyn=np.sum(Ispike[:,post])

        I=Isyn

        # ====================================================
        # ORIGINAL MEMBRANE EQUATION
        # ====================================================

        i_ion=gL[post]*(
            V[post,t-1]-V0[post]
        )

        dVdt=(I-i_ion)/C_m[post]

        V[post,t]=(
            V[post,t-1]
            +dt*dVdt
        )

        # ====================================================
        # ORIGINAL ADAPTIVE THRESHOLD EQUATION
        # ====================================================

        dvthdt=(
            -(vth[post,t-1]-vt[post])
            /tauvth[post]
        )

        vth[post,t]=(
            vth[post,t-1]
            +dt*dvthdt
        )

        # ====================================================
        # ONLY THE SELECTED PRESYNAPTIC NEURON IS ALLOWED
        # TO FIRE
        # ====================================================

        if post==SPIKE_FROM:

            if spikes[post,t]==1:

                vth[post,t]+=(
                    alpha[post,0]
                    +alpha[post,1]*(
                        V[post,t]/vt[post]
                    )
                    +alpha[post,2]*(
                        V[post,t]/vt[post]
                    )**2
                )

                V[post,t]=vr[post]

    # ========================================================
    # STORE SELECTED CONNECTION CURRENT
    # ========================================================

    I_selected[t]=Ispike[
        SPIKE_FROM,
        SPIKE_TO
    ]

    # ========================================================
    # STORE TARGET MEMBRANE-POTENTIAL CHANGE
    # ========================================================

    deltaV[t]=(
        V[SPIKE_TO,t]
        -V[SPIKE_TO,0]
    )

# ============================================================
# MEASURE PEAK MEMBRANE-POTENTIAL CHANGE
# ============================================================

if W[SPIKE_FROM,SPIKE_TO]>0:

    peak_index=np.argmax(deltaV)

else:

    peak_index=np.argmin(deltaV)

peak_deltaV=deltaV[peak_index]
peak_time=time[peak_index]


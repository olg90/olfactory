#%% 7 - Connection-specific SV pools with mini and AP release
# Gaussian noise only in FF neurons (modified) - mini corrected

import numpy as np
import matplotlib.pyplot as plt
from tqdm import tqdm

N=6
PYR1,PYR2,FB1,FB2,FF1,FF2=range(6)
names=["PYR1","PYR2","FB1","FB2","FF1","FF2"]

PYR=[PYR1,PYR2]
FB=[FB1,FB2]
FF=[FF1,FF2]

V0=np.zeros(N)
C_m=np.zeros(N)
vr=np.zeros(N)
gL=np.zeros(N)
vt=np.zeros(N)
tauvth=np.zeros(N)
alpha=np.zeros((N,3))

for i in PYR:
    V0[i]=-78e-3
    C_m[i]=300e-12
    vr[i]=-78e-3
    gL[i]=1/(50e6)
    vt[i]=-77e-3
    tauvth[i]=7e-3
    alpha[i]=[75e-3,0,0]

for i in FB:
    V0[i]=-78e-3
    C_m[i]=250e-12
    vr[i]=-78e-3
    gL[i]=1/(50e6)
    vt[i]=-62e-3
    tauvth[i]=1e-3
    alpha[i]=[1e-3,1e-3,1e-3]

for i in FF:
    V0[i]=-78e-3
    C_m[i]=650e-12
    vr[i]=-78e-3
    gL[i]=1/(120e6)
    vt[i]=-70e-3
    tauvth[i]=1e-3
    alpha[i]=[1e-3,1e-3,1e-3]

# ============================================================
# CONNECTION MATRIX
# W[pre,post] is the synaptic weight from pre to post
# ============================================================

# the refilling is assumed to occur quickly and the mean QC*weight
# is set to the average values so it's on average close to it
# don't change the strength parameters (sn1n2)

#pyr=2.6 Hz, fb=7 Hz, ff= 9 Hz

# fit weights to AP sizes, physiological parameters
spyrpyr=5e-12
spyrfb=17.5e-12
sfbpyr=-201.7e-12
sfbfb=sfbpyr
sffff=-264e-12
sffpyr=-201.7e-12
rminiPYR=30
rminiFB=30
rminiFF=30
kPYR1=1
kFB1=1
kFF1=1
prAPPYR=0.9
prAPFB=0.5
prAPFF=0.5
MPYR=5
MFB=5
MFF=5
noise=np.array([0.0,0.0,0*150e-12])
T=2.5
navgs=3
dt=1e-4
rf=1e-3
ttype=9

W=np.zeros((N,N))

W[PYR1,PYR2]=spyrpyr
W[PYR1,FB1]=spyrfb
W[PYR1,FB2]=spyrfb
W[PYR2,PYR1]=spyrpyr
W[PYR2,FB1]=spyrfb
W[PYR2,FB2]=spyrfb

W[FB1,PYR1]=sfbpyr
W[FB1,PYR2]=sfbfb
W[FB1,FB2]=sfbfb
W[FB2,PYR1]=sfbpyr
W[FB2,PYR2]=sfbpyr
W[FB2,FB1]=sfbfb

W[FF1,PYR1]=sffpyr
W[FF1,PYR2]=sffpyr
W[FF1,FF2]=sffff
W[FF2,PYR1]=sffpyr
W[FF2,PYR2]=sffpyr
W[FF2,FF1]=sffff

# ============================================================
# CONNECTION-SPECIFIC DOCKED SV POOLS
#
# M[pre,post] is the number of docked SVs belonging ONLY to
# the synapse from pre to post.
# ============================================================

M=np.zeros((N,N),dtype=int)

M[PYR1,PYR2]=MPYR
M[PYR1,FB1]=MPYR
M[PYR1,FB2]=MPYR
M[PYR2,PYR1]=MPYR
M[PYR2,FB1]=MPYR
M[PYR2,FB2]=MPYR

M[FB1,PYR1]=MFB
M[FB1,PYR2]=MFB
M[FB1,FB2]=MFB
M[FB2,PYR1]=MFB
M[FB2,PYR2]=MFB
M[FB2,FB1]=MFB

M[FF1,PYR1]=MFF
M[FF1,PYR2]=MFF
M[FF1,FF2]=MFF
M[FF2,PYR1]=MFF
M[FF2,PYR2]=MFF
M[FF2,FF1]=MFF

# ============================================================
# AP RELEASE PROBABILITIES
#
# prAP[pre,post] = fusion probability during an AP
#                  generated by the presynaptic neuron
# ============================================================

prAP=np.zeros((N,N))

for pre in PYR:
    for post in range(N):
        if W[pre,post]!=0:
            prAP[pre,post]=prAPPYR

for pre in FB:
    for post in range(N):
        if W[pre,post]!=0:
            prAP[pre,post]=prAPFB

for pre in FF:
    for post in range(N):
        if W[pre,post]!=0:
            prAP[pre,post]=prAPFF

# ============================================================
# SPONTANEOUS MINI EVENT RATES
#
# Each presynaptic-to-postsynaptic connection has its own
# independent Poisson process.
# ============================================================

mini_rate=np.zeros((N,N))

for pre in range(N):
    for post in range(N):
        if W[pre,post]!=0:
            if pre in PYR:
                mini_rate[pre,post]=rminiPYR
            elif pre in FB:
                mini_rate[pre,post]=rminiFB
            elif pre in FF:
                mini_rate[pre,post]=rminiFF

# ============================================================
# REPLENISHMENT RATE COEFFICIENT
#
# Still presynaptic-neuron-specific.
# Each connection-specific pool independently refills.
# ============================================================

kPYR2=kPYR1
kFB2=kFB1
kFF2=kFF1
k=[kPYR1,kPYR2,kFB1,kFB2,kFF1,kFF2]

time=np.arange(0,T,dt)

if ttype==0:
    W[PYR2,PYR1],W[PYR1,PYR2]=0,0

if ttype==1:
    W[FB1,PYR1],W[FB2,PYR1],W[FB1,PYR2],W[FB2,PYR2]=0,0,0,0

if ttype==2:
    W[FF1,PYR1],W[FF2,PYR1],W[FF1,PYR2],W[FF2,PYR2]=0,0,0,0

# ============================================================
# GAUSSIAN NOISE
#
# Only FF1 and FF2 receive Gaussian noise.
# PYR and FB neurons receive no Gaussian noise.
# ============================================================

def getnoise(noise,i):
    if i in PYR:
        return 0.0
    if i in FB:
        return 0.0
    return abs(np.random.normal(0,noise[2]))

# ============================================================
# RATE ACCUMULATION
# ============================================================

rate_acc=np.zeros((navgs,N))
std_acc=np.zeros((navgs,N))

V_last=None
I_last=None
spike_peak_last=None
Vth_last=None

# ============================================================
# SIMULATION
# ============================================================

taui_exc=20e-3
taui_inh=10e-3

for run in tqdm(range(navgs),desc="Running simulations",unit="run"):

    V=np.zeros((N,len(time)))
    vth=np.zeros((N,len(time)))
    spikes=np.zeros((N,len(time)))

    # Ispike[pre,post] is the current generated at the
    # connection from pre to post.
    Ispike=np.zeros((N,N))

    # Each synaptic connection has its own independent pool.
    ndsv=M.copy()

    # Independent replenishment timer for every synapse.
    next_refill=np.full((N,N),np.inf)

    # Independent next mini-event time for every
    # presynaptic-to-postsynaptic connection.
    next_mini=np.full((N,N),np.inf)

    for pre in range(N):
        for post in range(N):
            if W[pre,post]==0:
                continue

            if mini_rate[pre,post]>0:
                wait=np.random.exponential(1/mini_rate[pre,post])
                next_mini[pre,post]=wait

    if run==navgs-1:
        spike_peak_last=np.full((N,len(time)),np.nan)

        # Store total incoming current for every neuron.
        I_last=np.zeros((N,len(time)))

        # Store connection-specific incoming currents.
        # Iconn_last[pre,post,t] is the current from pre into post.
        Iconn_last=np.zeros((N,N,len(time)))

    V[:,0]=V0
    vth[:,0]=vt

    rfon=np.zeros(N)
    rftimer=np.ones(N)*np.inf

    # ========================================================
    # TIME LOOP
    # ========================================================

    for t in range(1,len(time)):

        current_time=t*dt

        # ====================================================
        # REPLENISH EACH SYNAPTIC POOL INDEPENDENTLY
        # ====================================================

        for pre in range(N):
            for post in range(N):
                if W[pre,post]==0:
                    continue

                if current_time>=next_refill[pre,post] and ndsv[pre,post]<M[pre,post]:
                    ndsv[pre,post]+=1

                    if ndsv[pre,post]<M[pre,post]:
                        rate=k[pre]*(M[pre,post]-ndsv[pre,post])
                        wait=np.random.exponential(1/rate)
                        next_refill[pre,post]=current_time+wait
                    else:
                        next_refill[pre,post]=np.inf

        # ====================================================
        # SPONTANEOUS MINI EVENTS
        #
        # Each synaptic connection has its own independent
        # Poisson process.
        #
        # Each mini event releases exactly one docked SV.
        # ====================================================

        for pre in range(N):
            for post in range(N):
                if W[pre,post]==0:
                    continue

                if current_time>=next_mini[pre,post]:

                    if ndsv[pre,post]>0:
                        ndsv[pre,post]-=1
                        Ispike[pre,post]+=W[pre,post]

                        if ndsv[pre,post]<M[pre,post]:
                            rate=k[pre]*(M[pre,post]-ndsv[pre,post])
                            wait=np.random.exponential(1/rate)
                            next_refill[pre,post]=current_time+wait

                    if mini_rate[pre,post]>0:
                        wait=np.random.exponential(1/mini_rate[pre,post])
                        next_mini[pre,post]=current_time+wait
                    else:
                        next_mini[pre,post]=np.inf

        # ====================================================
        # DECAY EACH SYNAPTIC CURRENT INDEPENDENTLY
        # ====================================================

        for pre in range(N):
            taui=taui_exc if pre in PYR else taui_inh

            for post in range(N):
                Ispike[pre,post]+=dt*(-Ispike[pre,post]/taui)

        # ====================================================
        # STORE INCOMING CURRENTS
        #
        # Iconn_last[pre,post,t] = current from pre into post.
        # I_last[post,t] = total synaptic current entering post.
        # ====================================================

        if run==navgs-1:
            Iconn_last[:,:,t]=Ispike

            for post in range(N):
                I_last[post,t]=np.sum(Ispike[:,post])

        # ====================================================
        # UPDATE NEURONS
        # ====================================================

        for post in range(N):

            Inoise=getnoise(noise,post)
            Isyn=np.sum(Ispike[:,post])
            I=Isyn+Inoise

            i_ion=gL[post]*(V[post,t-1]-V0[post])
            dVdt=(I-i_ion)/C_m[post]

            V[post,t]=V[post,t-1]+dt*dVdt*(1-rfon[post])

            # FIXED: vt and tauvth must be indexed by post
            dvthdt=-(vth[post,t-1]-vt[post])/tauvth[post]
            vth[post,t]=vth[post,t-1]+dt*dvthdt

            if rftimer[post]!=np.inf:
                rftimer[post]-=dt

            if rftimer[post]<=0:
                rftimer[post]=np.inf
                rfon[post]=False

            # =================================================
            # POSTSYNAPTIC NEURON FIRES AN AP
            # =================================================

            if V[post,t]>vth[post,t]:

                spikes[post,t]=1

                if run==navgs-1:
                    spike_peak_last[post,t]=V[post,t]

                rfon[post]=True
                rftimer[post]=rf

                # =============================================
                # AP-EVOKED RELEASE
                #
                # The AP from 'post' acts as a presynaptic AP
                # onto every target of neuron 'post'.
                #
                # Each connection independently draws from
                # its own SV pool using prAP[post,target].
                # =============================================

                for target in range(N):

                    if W[post,target]==0:
                        continue

                    B=np.random.binomial(ndsv[post,target],prAP[post,target])

                    ndsv[post,target]-=B
                    Ispike[post,target]+=W[post,target]*B

                    if B>0 and ndsv[post,target]<M[post,target]:
                        rate=k[post]*(M[post,target]-ndsv[post,target])
                        wait=np.random.exponential(1/rate)
                        next_refill[post,target]=current_time+wait

                # =============================================
                # ADAPTIVE THRESHOLD
                # =============================================

                vth[post,t]+=alpha[post,0]+alpha[post,1]*(V[post,t]/vt[post])+alpha[post,2]*(V[post,t]/vt[post])**2

                V[post,t]=vr[post]

    # ========================================================
    # SAVE FINAL RUN
    # ========================================================

    if run==navgs-1:
        V_last=V.copy()
        Vth_last=vth.copy()

    # ========================================================

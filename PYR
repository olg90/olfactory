    # ========================================================

    for t in range(1,len(time)):

        current_time=t*dt

        # ====================================================
        # REPLENISH EACH CONNECTION-SPECIFIC SV POOL
        # ====================================================

        for pre in range(N):

            for post in range(N):

                if W[pre,post]==0:
                    continue

                if current_time>=next_refill[pre,post] and ndsv[pre,post]<M[pre,post]:

                    ndsv[pre,post]+=1

                    if ndsv[pre,post]<M[pre,post]:

                        rate=k[pre]*(M[pre,post]-ndsv[pre,post])

                        wait=np.random.exponential(1/rate)

                        next_refill[pre,post]=current_time+wait

                    else:
                        next_refill[pre,post]=np.inf

        # ====================================================
        # SPONTANEOUS MINI EVENTS
        # ====================================================

        for pre in range(N):

            if current_time>=next_mini[pre]:

                for post in range(N):

                    if W[pre,post]==0:
                        continue

                    B=np.random.binomial(
                        ndsv[pre,post],
                        prmini[pre,post]
                    )

                    ndsv[pre,post]-=B

                    Ispike[pre,post]+=W[pre,post]*B

                    if B>0 and ndsv[pre,post]<M[pre,post]:

                        rate=k[pre]*(M[pre,post]-ndsv[pre,post])

                        wait=np.random.exponential(1/rate)

                        next_refill[pre,post]=current_time+wait

                if mini_rate[pre]>0:

                    wait=np.random.exponential(1/mini_rate[pre])

                    next_mini[pre]=current_time+wait

                else:
                    next_mini[pre]=np.inf

        # ====================================================
        # DECAY SYNAPTIC CURRENTS
        # ====================================================

        for pre in range(N):

            taui=taui_exc if pre in PYR else taui_inh

            for post in range(N):

                Ispike[pre,post]+=dt*(-Ispike[pre,post]/taui)

        # ====================================================
        # UPDATE NEURONS
        # ====================================================

        for post in range(N):

            Inoise=getnoise(noise,post)

            Isyn=np.sum(Ispike[:,post])

            I=Isyn+Inoise

            i_ion=gL[post]*(V[post,t-1]-V0[post])

            dVdt=(I-i_ion)/C_m[post]

            V[post,t]=V[post,t-1]+dt*dVdt*(1-rfon[post])

            dvthdt=-(vth[post,t-1]-vt[post])/tauvth[post]

            vth[post,t]=vth[post,t-1]+dt*dvthdt

            if rftimer[post]!=np.inf:
                rftimer[post]-=dt

            if rftimer[post]<=0:

                rftimer[post]=np.inf
                rfon[post]=False

            # =================================================
            # AP
            # =================================================

            if V[post,t]>vth[post,t]:

                spikes[post,t]=1

                spike_peak[run,post,t]=V[post,t]

                rfon[post]=True
                rftimer[post]=rf

                # =============================================
                # AP-EVOKED RELEASE
                # =============================================

                for target in range(N):

                    if W[post,target]==0:
                        continue

                    B=np.random.binomial(
                        ndsv[post,target],
                        prAP[post,target]
                    )

                    ndsv[post,target]-=B

                    Ispike[post,target]+=W[post,target]*B

                    if B>0 and ndsv[post,target]<M[post,target]:

                        rate=k[post]*(M[post,target]-ndsv[post,target])

                        wait=np.random.exponential(1/rate)

                        next_refill[post,target]=current_time+wait

                # =============================================
                # ADAPTIVE THRESHOLD
                # =============================================

                vth[post,t]+=(
                    alpha[post,0]
                    +alpha[post,1]*(V[post,t]/vt[post])
                    +alpha[post,2]*(V[post,t]/vt[post])**2
                )

                V[post,t]=vr[post]

    # ========================================================
    # SAVE RUN
    # ========================================================

    V_all[run]=V
    vth_all[run]=vth
    spikes_all[run]=spikes

    # ========================================================
    # FIRING RATE
    # ========================================================

    for i in range(N):

        spike_times=time[spikes[i]==1]

        if len(spike_times)>1:

            isi=np.diff(spike_times)

            rate_acc[run,i]=1/np.mean(isi)

        else:
            rate_acc[run,i]=np.nan

# ============================================================
# RESULTS
# ============================================================

mean_rate=np.nanmean(rate_acc,axis=0)

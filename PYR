# ============================================================
# INITIAL CONDITIONS
# ============================================================

V[:,0]=V0
vth[:,0]=vt

# ============================================================
# TIME LOOP
# ============================================================

for t in range(1,len(time)):

    current_time=t*dt

    # ========================================================
    # DECAY EACH SYNAPTIC CURRENT
    #
    # THIS IS IDENTICAL TO THE ORIGINAL MODEL
    # ========================================================

    for pre in range(N):

        taui=taui_exc if pre in PYR else taui_inh

        for post in range(N):

            Ispike[pre,post]+=dt*(
                -Ispike[pre,post]/taui
            )

    # ========================================================
    # FORCE ONE PRESYNAPTIC AP
    # ========================================================

    if abs(current_time-SPIKE_TIME)<dt/2:

        spikes[SPIKE_FROM,t]=1

